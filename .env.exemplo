# Copie para .env (fica fora do git) e preencha.

# Senha para abrir o escritório no navegador (obrigatória no VPS). Os motores externos usam a mesma, como token.
ESCRITORIO_SENHA=troque-por-uma-senha-forte
# ESCRITORIO_TOKEN=um-token-separado-para-os-motores

# Chaves de API: só das IAs que você usar no motores.json. São cobradas por uso, à parte das assinaturas de chat.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Planos grátis (veja motores.gratis.json):
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Domínio para HTTPS (docker compose --profile https up -d). Com HTTPS, feche a porta 8787 no firewall.
DOMINIO=
