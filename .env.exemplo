# Copie para .env (fica fora do git) e preencha.

# Senha para abrir o escritório no navegador (obrigatória no VPS). Os motores externos usam a mesma, como token.
ESCRITORIO_SENHA=troque-por-uma-senha-forte
# ESCRITORIO_TOKEN=um-token-separado-para-os-motores

# Chaves de API: só das IAs que você usar no motores.json. São cobradas por uso, à parte das assinaturas de chat.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Planos grátis (veja motores.gratis.json):
GROQ_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA: build.nvidia.com (grátis, ~40 pedidos/min)
NVIDIA_API_KEY=
# Mistral: console.mistral.ai (plano grátis)
MISTRAL_API_KEY=

# Domínio para HTTPS (docker compose --profile https up -d). Com HTTPS, feche a porta 8787 no firewall.
DOMINIO=

# Laya (decide qual agente cuida das ordens "Automático"). Roda no próprio VPS, de graça.
# Para ligar: descomente as duas linhas abaixo e rode: docker compose up -d --build
# LAYA_URL=http://laya:8000
# LAYA_THREADS=2              (núcleos de CPU que o Laya pode usar)
# LAYA_CONFIANCA_MINIMA=0.25  (abaixo disso, na dúvida, manda para o Orquestrador)
# LAYA_METODO=combinado      (combinado | escolha | simnao: como o Crânio pergunta ao Laya)

# Serviços extras do docker-compose que sobem junto: https (cadeado) e laya.
COMPOSE_PROFILES=https

# Documentação viva: agente que mantém o documento do projeto e de quantos em quantos minutos atualiza
# DOCUMENTADOR=redator
# DOC_INTERVALO_MIN=3

# Telegram (ordens e entregas): crie um bot no @BotFather, cole o token aqui, reinicie
# e mande /start para o bot. O primeiro chat que mandar /start fica conectado.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=   (opcional: fixa o chat à mão)

# Revisor automático: quem revisa as entregas dos agentes marcados com "passam pelo Revisor"
# REVISOR=revisor

# Marca do escritório: nome e subtítulo no topo e na placa da parede, cor de destaque (hex)
# MARCA_NOME=Minha Agência
# MARCA_SUBTITULO=escritório de agentes de IA
# MARCA_COR=#e11d2a

# Piloto automático do Tech Lead: liga/desliga, intervalo, limite por dia e horário ficam na janela 🗓 Rotinas
# (guardados em dados/autopiloto.json). Começa ligado: 1 plano por projeto por hora, até 8 por dia, das 8h às 20h.

# GitHub: cada projeto (cliente) vira um repositório privado e o código que o time entrega vira PR.
# O CI (GitHub Actions) roda os testes e o QA revisa o código; se algo falhar, o agente corrige no
# mesmo PR (até 3 vezes); tudo certo, o PR é mesclado sozinho. Token "fine-grained" (github.com/settings/personal-access-tokens)
# com acesso a "All repositories" e as permissões (Read and write): Administration, Contents,
# Pull requests e Workflows. Actions, Commit statuses e Deployments: Read-only.
# GITHUB_TOKEN=github_pat_...
# GITHUB_DONO=            (opcional: organização onde criar os repositórios; vazio = sua conta)
# GITHUB_PREFIXO=         (opcional: prefixo no nome dos repositórios, ex.: cliente-)
# GITHUB_AUTO_MERGE=1     (0 = o PR espera você mesclar, mesmo com o CI verde)
# GITHUB_REVISAO=1        (0 = sem revisão de código do QA antes do merge)
# GITHUB_REVISOR=qa       (quem revisa os PRs; padrão: o QA)
